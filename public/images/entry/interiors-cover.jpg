<svg width="1200" height="900" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F3F0E9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E8E2D6;stop-opacity:1" />
    </linearGradient>
    <pattern id="noise" width="4" height="4" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="0.5" fill="#D6CEC0" opacity="0.3"/>
      <circle cx="3" cy="3" r="0.5" fill="#D6CEC0" opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <rect width="100%" height="100%" fill="url(#noise)"/>
  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Georgia, serif" font-size="24" fill="#9A9387" font-weight="400">Grid Homes</text>
  <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" fill="#9A9387" font-weight="500" letter-spacing="0.1em">PLACEHOLDER IMAGE</text>
</svg>